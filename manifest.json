{
  "manifest_version": 3,
  "name": "YT Music Custom Player & Whitelist Scrobbler",
  "version": "3.4.0",
  "description": "Pemutar antrean YT Music dari catatan teks dengan whitelist scrobbler lokal.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "action": {
    "default_title": "YT Music Scrobbler",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Ctrl+Shift+Space" },
      "description": "Play / Pause"
    },
    "next-track": {
      "suggested_key": { "default": "Ctrl+Shift+Right" },
      "description": "Lagu berikutnya"
    },
    "prev-track": {
      "suggested_key": { "default": "Ctrl+Shift+Left" },
      "description": "Lagu sebelumnya"
    },
    "toggle-ad-skip": {
      "suggested_key": { "default": "Ctrl+Shift+A" },
      "description": "Toggle skip iklan otomatis"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "110"
}